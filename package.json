{
  "name": "iphone-clipboard",
  "version": "1.0.0",
  "description": "Copy the latest iPhone photo to the Linux clipboard",
  "main": "desktop.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "desktop": "node desktop-launcher.js",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "keywords": [],
  "author": "waterfalleq",
  "homepage": "https://github.com/waterfalleq/iphone-clipboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/waterfalleq/iphone-clipboard.git"
  },
  "cloudflare": {
    "bindings": {
      "API_TOKEN": {
        "description": "Create a long random token and save it. You will need the same token for the iPhone Shortcut and the desktop app."
      },
      "IMAGES": {
        "description": "Private R2 bucket that stores the latest uploaded image."
      }
    }
  },
  "license": "ISC",
  "type": "module",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "electron": "^44.1.0",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
}
